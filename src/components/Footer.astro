---
import SectionLabel from './SectionLabel.astro';

const contato = [
  { label: 'GITHUB', rotulo: 'Código', href: 'https://github.com/freit4sdev', external: true },
  { label: 'LINKEDIN', rotulo: 'Rede', href: 'https://linkedin.com/in/michel-de-freitas', external: true },
  { label: 'E-MAIL', rotulo: 'Contato', href: 'mailto:michel@michelfreitas.com', external: false },
];
---

<footer>
  <div class="grid grid-cols-1 md:grid-cols-3">
    {contato.map((link) => (
      <a
        href={link.href}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
        class="group flex flex-col justify-between gap-10 border-b border-border/10 p-4 transition-colors duration-200 ease hover:bg-foreground hover:text-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-background last:border-b-0 md:border-b-0 md:border-r md:p-6 md:last:border-r-0 lg:p-10"
      >
        <SectionLabel class="bg-foreground text-background transition-colors duration-200 ease group-hover:bg-background group-hover:text-foreground">{link.rotulo}</SectionLabel>
        <span class="flex items-end justify-between gap-4">
          <span class="font-sans font-bold uppercase leading-none -tracking-[0.03em] text-[clamp(2.5rem,6vw,5rem)]">{link.label}</span>
          <span class="text-muted-foreground transition-colors duration-200 ease group-hover:text-background">↗</span>
        </span>
      </a>
    ))}
  </div>

  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-t border-border/10 px-4 py-3 md:px-6 lg:px-10">
    <span class="font-mono text-[0.625rem] uppercase tracking-[0.12em] text-muted-foreground">© 2026 Michel de Freitas</span>
    <span class="font-mono text-[0.625rem] uppercase tracking-[0.12em] text-muted-foreground">São Paulo, SP</span>
    <span class="font-mono text-[0.625rem] uppercase tracking-[0.12em] text-muted-foreground">Astro · Tailwind CSS</span>
  </div>
</footer>