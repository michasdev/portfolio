---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const contactLinks = [
  { label: 'GITHUB', href: 'https://github.com/freit4sdev', external: true },
  { label: 'LINKEDIN', href: 'https://linkedin.com/in/michel-de-freitas', external: true },
  { label: 'E-MAIL', href: 'mailto:michel@michelfreitas.com' },
];
---

<section
  id="inicio"
  class:list={['min-h-screen flex flex-col border-b border-border/10 pt-16 md:pt-20', className]}
>
  <div class="border-b border-border/10 px-4 md:px-6 py-3 md:py-4">
    <p class="font-mono text-[0.6875rem] md:text-xs uppercase tracking-[0.12em] text-muted-foreground">
      ENGENHEIRO DE SOFTWARE — SÃO PAULO, SP
    </p>
  </div>

  <div class="flex-1 grid grid-cols-1 md:grid-cols-4 md:grid-rows-[1fr_auto_auto]">
    <div class="md:col-span-3 md:col-start-1 md:row-start-1 p-4 md:p-6 lg:p-10 border-b border-border/10 md:border-r flex items-end">
      <h1 class="font-sans font-bold uppercase leading-[0.85] -tracking-[0.04em] text-[clamp(3.25rem,13vw,9rem)] break-words">
        MICHEL
        <span class="block">DE FREITAS</span>
      </h1>
    </div>

    <div class="md:col-start-4 md:row-start-1 p-4 md:p-6 lg:p-8 border-b border-border/10 bg-foreground text-background flex flex-col">
      <span class="font-mono text-[0.6875rem] md:text-xs uppercase tracking-[0.12em] text-background/60">Função</span>
      <strong class="mt-3 font-sans text-xl lg:text-2xl xl:text-3xl font-bold uppercase leading-[1] -tracking-[0.02em] break-words">
        ENGENHEIRO DE SOFTWARE
      </strong>
      <dl class="mt-16 md:mt-24 flex flex-col">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-background/20 py-3">
          <dt class="font-mono text-[0.625rem] uppercase tracking-[0.12em] text-background/60">Base</dt>
          <dd class="font-mono text-[0.6875rem] md:text-xs uppercase tracking-[0.08em]">SÃO PAULO, SP</dd>
        </div>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-background/20 py-3">
          <dt class="font-mono text-[0.625rem] uppercase tracking-[0.12em] text-background/60">Atualmente</dt>
          <dd class="font-mono text-[0.6875rem] md:text-xs uppercase tracking-[0.08em]">R2 VENTURES</dd>
        </div>
        <div class="border-t border-background/20 py-3">
          <dt class="font-mono text-[0.625rem] uppercase tracking-[0.12em] text-background/60">Formação</dt>
          <dd class="mt-2 font-mono text-[0.6875rem] md:text-xs uppercase tracking-[0.08em]">
            FIAP — CIÊNCIAS DA COMPUTAÇÃO
          </dd>
        </div>
      </dl>
    </div>

    <div class="md:col-span-3 md:col-start-1 md:row-start-2 p-4 md:p-6 lg:p-10 border-b border-border/10 md:border-r flex flex-col gap-6">
      <span class="font-mono text-[0.6875rem] md:text-xs uppercase tracking-[0.12em] text-muted-foreground">Perfil</span>
      <p class="font-sans text-lg md:text-xl lg:text-2xl leading-snug max-w-3xl">
        Curioso e criativo, programo desde os 12. Construo sistemas robustos e estou sempre em busca de novos desafios e aprendizados.
      </p>
    </div>

    <div class="md:col-span-4 md:col-start-1 md:row-start-3 px-4 md:px-6 lg:px-10 py-4 md:py-5 border-b border-border/10 md:border-b-0 flex items-start gap-4 md:gap-6">
      <span class="font-mono text-[0.625rem] md:text-[0.6875rem] uppercase tracking-[0.12em] text-muted-foreground">Stack</span>
      <p class="font-mono text-sm tracking-[0.1em] text-muted-foreground lowercase">
        aws • golang • typescript • node.js • terraform
      </p>
    </div>

    <div class="md:col-start-4 md:row-start-2 p-4 md:p-6 lg:p-8 md:border-b border-border/10 flex flex-col gap-6">
      <span class="font-mono text-[0.6875rem] md:text-xs uppercase tracking-[0.12em] text-muted-foreground">Contato</span>
      <nav class="flex flex-col">
        {contactLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="group flex items-center justify-between gap-6 border-t border-border/10 py-4 font-mono text-xs md:text-sm uppercase tracking-[0.1em] text-foreground hover:text-muted-foreground transition-colors duration-200 ease focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            <span>{link.label}</span>
            <span class="text-muted-foreground group-hover:text-foreground transition-colors duration-200 ease">↗</span>
          </a>
        ))}
      </nav>
    </div>
  </div>
</section>
